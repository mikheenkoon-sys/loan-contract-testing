{
  "consumer": {
    "name": "LoanWebApp"
  },
  "interactions": [
    {
      "description": "a request for loan 123",
      "pending": false,
      "providerStates": [
        {
          "name": "loan 123 exists and is approved"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/loans/123"
      },
      "response": {
        "body": {
          "content": {
            "amount": 1500,
            "currency": "EUR",
            "id": 123,
            "status": "APPROVED"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(EUR|USD|GBP)$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "LoanService"
  }
}